<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Login</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', sans-serif;
    }

    body {
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      color: white;
    }

    .login-container {
      background: white;
      color: black;
      padding: 40px;
      border-radius: 12px;
      width: 320px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      text-align: center;
    }

    .login-container h2 {
      margin-bottom: 20px;
      color: #0f172a;
    }

    .input-group {
      margin-bottom: 15px;
      text-align: left;
    }

    .input-group label {
      font-size: 14px;
      margin-bottom: 5px;
      display: block;
    }

    input {
      width: 100%;
      padding: 10px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      outline: none;
    }

    input:focus {
      border-color: #38bdf8;
    }

    button {
      width: 100%;
      padding: 10px;
      background: #0f172a;
      color: white;
      border: none;
      border-radius: 6px;
      margin-top: 10px;
      cursor: pointer;
      font-weight: 600;
    }

    button:hover {
      background: #1e293b;
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
      margin-bottom: 10px;
      color: #38bdf8;
    }
  </style>
</head>

<body>

<div class="login-container">

  <div class="logo">FinTrack</div>
  <h2>Admin Login</h2>

  <form method="POST" action="/admin/login">

    <div class="input-group">
      <label>Email</label>
      <input type="email" name="email" required />
    </div>

    <div class="input-group">
      <label>Password</label>
      <input type="password" name="password" required />
    </div>

    <button type="submit">Login</button>

  </form>

</div>

</body>
</html>